#!/usr/bin/env python3
"""Run in the host desktop session. Receives agent pings and clears; never retries."""
from contextlib import closing
from http.client import HTTPSConnection, HTTPException
from http.server import BaseHTTPRequestHandler, ThreadingHTTPServer
from threading import Timer
from urllib.parse import urlencode, urlsplit
import html
import json
import subprocess
import sys

MOBILE_ENDPOINT = 'https://samporapeli.fi/yhteydenotto/'
GENERIC = 'Agent sent a notification'
ERRORS = (OSError, ValueError, subprocess.SubprocessError, HTTPException)


def run(*args):
    return subprocess.run(args, capture_output=True, text=True, check=True, timeout=3)


def mobile(sender):
    url = urlsplit(MOBILE_ENDPOINT)
    if url.hostname is None:
        raise ValueError("Mobile endpoint must include a hostname")
    with closing(HTTPSConnection(url.hostname, url.port, timeout=8)) as connection:
        connection.request("POST", url.path + ("?" + url.query if url.query else ""),
                           urlencode({"Viesti": GENERIC}),
                           {"Content-Type": "application/x-www-form-urlencoded",
                            "User-Agent": sender})
        if connection.getresponse().status // 100 != 2:
            raise OSError("mobile submission failed")


def expire(number):
    try:
        dispatch("/clear", {"id": number})
    except ERRORS:
        print("Timed notification clear failed.", file=sys.stderr)


def dispatch(path, data):
    if path == "/clear":
        number = data["id"]
        if type(number) is not int or not 0 < number < 2**32:
            raise ValueError("invalid ID")
        try:
            run("gdbus", "call", "--session", "--dest", "org.freedesktop.Notifications",
                "--object-path", "/org/freedesktop/Notifications", "--method",
                "org.freedesktop.Notifications.CloseNotification", str(number))
        except subprocess.CalledProcessError as error:
            if not any(text in error.stderr for text in ("InvalidId", "InvalidArgs",
                                                        "Invalid notification")):
                raise
        return {"desktop": "cleared"}
    if path != "/ping":
        raise ValueError("unknown operation")
    sender, message, ttl = data["sender"], data["message"], data.get("ttl", -1)
    if (not isinstance(sender, str) or not sender.isascii()
            or any(ord(c) < 32 for c in sender)
            or not isinstance(message, str) or not 1 <= len(message.split()) <= 5
            or len(message) > 120 or any(ord(c) < 32 for c in message)
            or type(ttl) is not int or not -1 <= ttl <= 86400
            or type(data.get("mobile", False)) is not bool):
        raise ValueError("invalid ping")
    result = {"id": None, "desktop": "failed", "mobile": "not_requested"}
    try:
        sent = run("notify-send", "--print-id", "--app-name=Agent ping",
                   f"--expire-time={0 if ttl >= 0 else -1}",
                   "--", sender, html.escape(message.strip()))
        result.update(id=int(sent.stdout.strip()), desktop="submitted")
        if ttl > 0:
            timer = Timer(ttl, expire, args=(result["id"],))
            timer.daemon = True
            timer.start()
    except ERRORS:
        pass
    if data.get("mobile", False):
        result["mobile"] = "failed"
        try:
            mobile(sender)
            result["mobile"] = "submitted"
        except ERRORS:
            pass
    return result


class Handler(BaseHTTPRequestHandler):
    def setup(self):
        super().setup()
        self.connection.settimeout(5)

    def log_message(self, format: str, *args: object) -> None:
        pass

    def reply(self, status, data):
        body = json.dumps(data).encode()
        self.send_response(status)
        self.send_header("Content-Type", "application/json")
        self.send_header("Content-Length", str(len(body)))
        self.send_header("Connection", "close")
        self.end_headers()
        self.close_connection = True
        self.wfile.write(body)

    def do_POST(self):
        if self.headers.get_content_type() != "application/json":
            self.reply(415, {"error": "Content-Type must be application/json"})
            return
        try:
            length = int(self.headers.get("Content-Length", "0"))
            if not 0 < length <= 2048:
                raise ValueError("invalid body length")
            data = dispatch(self.path, json.loads(self.rfile.read(length)))
            self.reply(502 if "failed" in data.values() else 200, data)
        except (KeyError, TypeError, ValueError):
            self.reply(400, {"error": "invalid request; message: 1–5 words, max 120 characters"})
        except ERRORS:
            self.reply(502, {"error": "notification operation failed"})


if __name__ == "__main__":
    bridge_ip = run("docker", "network", "inspect", "bridge", "--format",
                    "{{(index .IPAM.Config 0).Gateway}}").stdout.strip()
    if not bridge_ip:
        raise RuntimeError("Docker bridge has no gateway")
    with ThreadingHTTPServer((bridge_ip, 10111), Handler) as server:
        print(f"Listening on http://{bridge_ip}:10111", flush=True)
        try:
            server.serve_forever()
        except KeyboardInterrupt:
            pass
