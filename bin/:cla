#!/bin/bash
set -eo pipefail

VERSION="1.3.0"
IMAGE_PREFIX="cla"
CONFIG_DIR="${HOME}/.config/cla"
TEMPLATES_DIR="${CONFIG_DIR}/_templates"
DOCKERFILE_TEMPLATE="${TEMPLATES_DIR}/Dockerfile"
CLAUDEJSON_TEMPLATE="${TEMPLATES_DIR}/claude.json"
OPENCODEJSON_TEMPLATE="${TEMPLATES_DIR}/opencode.json"
AGENTS_TEMPLATE="${TEMPLATES_DIR}/AGENTS.md"
ANTIGR_TEMPLATE="${TEMPLATES_DIR}/antigravity.json"
COPILOT_TEMPLATE="${TEMPLATES_DIR}/copilot-instructions.md"
INSTALL_SCRIPTS_SRC="${CONFIG_DIR}/_install_scripts"

show_usage() {
    cat << EOF
:cla v${VERSION} - isolated AI coding environments

Usage: :cla <profile-name> [OPTIONS]

Options:
    --build               Force rebuild of Docker image
    --reset-dockerfile    Reset Dockerfile from template
    --version             Show version
    -h, --help            Show this help message

Examples:
    :cla work                            # Launch shell with 'work' profile
    :cla work --build                    # Force rebuild and launch
    :cla work --reset-dockerfile         # Reset 'work' Dockerfile to default
EOF
}

# Parse arguments
PROFILE_NAME=""
BUILD_IMAGE=false
RESET_DOCKERFILE=false

while [[ $# -gt 0 ]]; do
    case $1 in
        -h|--help)
            show_usage
            exit 0
            ;;
        --version)
            echo "v${VERSION}"
            exit 0
            ;;
        --build)
            BUILD_IMAGE=true
            shift
            ;;
        --reset-dockerfile)
            RESET_DOCKERFILE=true
            shift
            ;;
        --shell)
            shift
            ;;
        -*)
            echo "Error: Unknown option $1"
            show_usage
            exit 1
            ;;
        *)
            if [ -z "$PROFILE_NAME" ]; then
                PROFILE_NAME="$1"
            else
                echo "Error: Multiple profile names specified: '$PROFILE_NAME' and '$1'"
                show_usage
                exit 1
            fi
            shift
            ;;
    esac
done

if [ -z "$PROFILE_NAME" ]; then
    echo "Error: Profile name required"
    echo ""
    show_usage
    exit 1
fi

if [[ "$PROFILE_NAME" == _* ]]; then
    echo "Error: Invalid profile name (name must not start with an underscore)"
    exit 1
fi

IMAGE_NAME="${IMAGE_PREFIX}-${PROFILE_NAME}"
PROFILE_CONFIG_DIR="${CONFIG_DIR}/${PROFILE_NAME}"
CLAUDE_DIR="${PROFILE_CONFIG_DIR}/_claude/.claude"
CLAUDEJSON_PATH="${PROFILE_CONFIG_DIR}/_claude/claude.json"
PI_DIR="${PROFILE_CONFIG_DIR}/_pi/.pi"
OPENCJSON_PATH="${PROFILE_CONFIG_DIR}/_opencode/opencode.jsonc"
AGENTS_PATH="${PROFILE_CONFIG_DIR}/_opencode/AGENTS.md"
ANTIGR_GEMINI_DIR="${PROFILE_CONFIG_DIR}/_antigravity/.gemini"
ANTIGR_SETTINGS_PATH="${ANTIGR_GEMINI_DIR}/antigravity-cli/settings.json"
COPILOT_HOME_DIR="${PROFILE_CONFIG_DIR}/_copilot/.copilot"
COPILOT_INSTRUCTIONS_PATH="${COPILOT_HOME_DIR}/copilot-instructions.md"
PROFILE_DOCKERFILE="${PROFILE_CONFIG_DIR}/Dockerfile"

# --- Migration logic ---
if [ -d "${PROFILE_CONFIG_DIR}" ]; then
    if [ ! -d "${PROFILE_CONFIG_DIR}/_claude" ]; then
        echo "Profile '${PROFILE_NAME}' uses old directory structure."
        echo "Files will be moved into _claude/ subdirectory."
        read -r -p "Migrate? [y/N] " MIGRATE || MIGRATE="n"
        if [[ "$MIGRATE" =~ ^[Yy]$ ]]; then
            mkdir -p "${PROFILE_CONFIG_DIR}/_claude"

            if [ -f "${PROFILE_CONFIG_DIR}/claude.json" ]; then
                mv "${PROFILE_CONFIG_DIR}/claude.json" "${PROFILE_CONFIG_DIR}/_claude/claude.json"
            fi
            if [ -d "${PROFILE_CONFIG_DIR}/.claude" ]; then
                mv "${PROFILE_CONFIG_DIR}/.claude" "${PROFILE_CONFIG_DIR}/_claude/.claude"
            fi

            echo "  ✓ Migrated to new directory structure"
        else
            echo "  ⚠ Skipping migration (proceeding with old structure)"
        fi
    fi
fi

# --- Create directory structure ---
mkdir -p "${PROFILE_CONFIG_DIR}/_claude"
mkdir -p "${CLAUDE_DIR}"
mkdir -p "${PROFILE_CONFIG_DIR}/_opencode/share"
mkdir -p "${PROFILE_CONFIG_DIR}/_opencode/state"
mkdir -p "${PI_DIR}"
mkdir -p "${ANTIGR_GEMINI_DIR}/antigravity-cli"
mkdir -p "${COPILOT_HOME_DIR}"

# --- Copy templates ---
if [ ! -f "${DOCKERFILE_TEMPLATE}" ]; then
    echo "Error: Could not find Dockerfile template at $DOCKERFILE_TEMPLATE"
    exit 1
fi
if [ ! -f "${CLAUDEJSON_TEMPLATE}" ]; then
    echo "Error: Could not find claude.json template at $CLAUDEJSON_TEMPLATE"
    exit 1
fi
if [ ! -f "${OPENCODEJSON_TEMPLATE}" ]; then
    echo "Error: Could not find opencode.json template at $OPENCODEJSON_TEMPLATE"
    exit 1
fi
if [ ! -f "${AGENTS_TEMPLATE}" ]; then
    echo "Error: Could not find AGENTS.md template at $AGENTS_TEMPLATE"
    exit 1
fi

# Copy Dockerfile from template if it doesn't exist
if [ ! -f "${PROFILE_DOCKERFILE}" ]; then
    cp "${DOCKERFILE_TEMPLATE}" "${PROFILE_DOCKERFILE}"
fi

# Copy claude.json from template if it doesn't exist
if [ ! -f "${CLAUDEJSON_PATH}" ]; then
    cp "${CLAUDEJSON_TEMPLATE}" "${CLAUDEJSON_PATH}"
fi

# Copy opencode.jsonc from template if it doesn't exist
if [ ! -f "${OPENCJSON_PATH}" ]; then
    cp "${OPENCODEJSON_TEMPLATE}" "${OPENCJSON_PATH}"
fi

# Copy AGENTS.md from template if it doesn't exist
if [ ! -f "${AGENTS_PATH}" ]; then
    cp "${AGENTS_TEMPLATE}" "${AGENTS_PATH}"
fi

# Copy AGENTS.md to GEMINI.md for Antigravity CLI (if AGENTS.md exists and GEMINI.md doesn't)
GEMINI_PATH="${ANTIGR_GEMINI_DIR}/GEMINI.md"
if [ -f "${AGENTS_PATH}" ] && [ ! -f "${GEMINI_PATH}" ]; then
    cp "${AGENTS_PATH}" "${GEMINI_PATH}"
fi

# Copy AGENTS.md to CLAUDE.md for Claude Code (if AGENTS.md exists and CLAUDE.md doesn't)
CLAUDE_MD_PATH="${PROFILE_CONFIG_DIR}/_claude/CLAUDE.md"
if [ -f "${AGENTS_PATH}" ] && [ ! -f "${CLAUDE_MD_PATH}" ]; then
    cp "${AGENTS_PATH}" "${CLAUDE_MD_PATH}"
fi

# Copy antigravity settings if they don't exist
if [ -f "${ANTIGR_TEMPLATE}" ] && [ ! -f "${ANTIGR_SETTINGS_PATH}" ]; then
    cp "${ANTIGR_TEMPLATE}" "${ANTIGR_SETTINGS_PATH}"
fi

# Copy AGENTS.md to copilot-instructions.md for Copilot CLI (if AGENTS.md exists and copilot-instructions.md doesn't)
if [ -f "${AGENTS_PATH}" ] && [ ! -f "${COPILOT_INSTRUCTIONS_PATH}" ]; then
    cp "${AGENTS_PATH}" "${COPILOT_INSTRUCTIONS_PATH}"
fi

# Handle --reset-dockerfile
if [ "${RESET_DOCKERFILE}" = true ]; then
    echo "Resetting Dockerfile for profile '${PROFILE_NAME}'..."
    cp "${DOCKERFILE_TEMPLATE}" "${PROFILE_DOCKERFILE}"
    echo "  ✓ Dockerfile reset from template"
    echo "Reset complete."
    exit 0
fi

# Build the Docker image if it doesn't exist or the --build flag is used
if [ "${BUILD_IMAGE}" = true ] || ! docker image inspect "${IMAGE_NAME}" > /dev/null 2>&1; then
    echo "Building Docker image: ${IMAGE_NAME}"
    docker build --no-cache \
        -t "${IMAGE_NAME}" \
        -f "${PROFILE_DOCKERFILE}" \
        --build-context install_scripts="${INSTALL_SCRIPTS_SRC}" \
        "${PROFILE_CONFIG_DIR}"
fi

# --- Build docker run command ---
DOCKER_RUN=(
    docker run
    --rm
    -it
    -v "${PWD}:/workspace/${PWD}"
    -v "${CLAUDE_DIR}:/home/cla/.claude"
    -v "${CLAUDEJSON_PATH}:/home/cla/.claude.json"
    -v "${PI_DIR}:/home/cla/.pi"
    -v "${AGENTS_PATH}:/home/cla/.config/opencode/AGENTS.md"
    -v "${OPENCJSON_PATH}:/home/cla/.config/opencode/opencode.jsonc"
    -v "${PROFILE_CONFIG_DIR}/_opencode/share:/home/cla/.local/share/opencode"
    -v "${PROFILE_CONFIG_DIR}/_opencode/state:/home/cla/.local/state/opencode"
    -v "${ANTIGR_GEMINI_DIR}:/home/cla/.gemini"
    -v "${COPILOT_HOME_DIR}:/home/cla/.copilot"
    -v /etc/localtime:/etc/localtime:ro
    -e TERM=xterm-256color
    -e SAMPORAPELI_ZSH_ENVIRONMENT="${IMAGE_NAME}"
    --cap-drop=ALL
    --security-opt=no-new-privileges
    --memory=4g
    --cpus=2
    --pids-limit=100
    -w "/workspace/${PWD}"
    "${IMAGE_NAME}"
    /bin/zsh
)

"${DOCKER_RUN[@]}"
