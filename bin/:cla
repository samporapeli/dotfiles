#!/bin/bash
set -eo pipefail

VERSION="1.5.0"
IMAGE_PREFIX="cla"
CONFIG_DIR="${HOME}/.config/cla"
TEMPLATES_DIR="${CONFIG_DIR}/_templates"
SKILLS_TEMPLATE_DIR="${TEMPLATES_DIR}/skills"
DOCKERFILE_TEMPLATE="${TEMPLATES_DIR}/Dockerfile"
DOCKERIGNORE_TEMPLATE="${TEMPLATES_DIR}/.dockerignore"
CLAUDE_TEMPLATE_DIR="${TEMPLATES_DIR}/claude"
CLAUDEJSON_TEMPLATE="${CLAUDE_TEMPLATE_DIR}/claude.json"
CLAUDE_SETTINGS_TEMPLATE="${CLAUDE_TEMPLATE_DIR}/.claude/settings.json"
OPENCODE_TEMPLATE_DIR="${TEMPLATES_DIR}/opencode"
ANTIGRAVITY_TEMPLATE_DIR="${TEMPLATES_DIR}/antigravity"
PI_TEMPLATE_DIR="${TEMPLATES_DIR}/pi"
CODEX_TEMPLATE_DIR="${TEMPLATES_DIR}/codex"
GROK_TEMPLATE_DIR="${TEMPLATES_DIR}/grok"
JUNIE_TEMPLATE_DIR="${TEMPLATES_DIR}/junie"
AGENTS_TEMPLATE="${TEMPLATES_DIR}/AGENTS.md"
INSTALL_SCRIPTS_SRC="${CONFIG_DIR}/_install_scripts"

list_skills() {
    local profile="$1"
    local skill_names=()
    mapfile -t skill_names < <(
        {
            [ -n "${profile}" ] && [ -d "${SKILLS_DIR}" ] && find "${SKILLS_DIR}" -mindepth 1 -maxdepth 1 -type d -exec basename {} \;
            [ -d "${SKILLS_TEMPLATE_DIR}" ] && find "${SKILLS_TEMPLATE_DIR}" -mindepth 1 -maxdepth 1 -type d -exec basename {} \;
        } | sort -u
    )

    if [ ${#skill_names[@]} -eq 0 ]; then
        if [ -n "${profile}" ]; then
            echo "No skills found in profile '${profile}' or templates."
        else
            echo "No skills found in shared templates (${SKILLS_TEMPLATE_DIR})."
        fi
        return 0
    fi

    printf "%-10s  %s\n" "STATUS" "SKILL"
    printf "%-10s  %s\n" "------" "-----"

    for skill in "${skill_names[@]}"; do
        [ -n "${skill}" ] || continue
        local p_dir="${SKILLS_DIR}/${skill}"
        local t_dir="${SKILLS_TEMPLATE_DIR}/${skill}"
        local in_profile=false
        local in_templates=false
        local marker=""
        local note=""

        [ -n "${profile}" ] && [ -d "${p_dir}" ] && in_profile=true
        [ -d "${t_dir}" ] && in_templates=true

        if [ "${in_profile}" = true ] && [ "${in_templates}" = true ]; then
            if diff -rq "${p_dir}" "${t_dir}" >/dev/null 2>&1; then
                marker="shared"
            else
                marker="modified"
            fi
            if [ ! -f "${p_dir}/SKILL.md" ] && [ ! -f "${t_dir}/SKILL.md" ]; then
                note=" (missing SKILL.md)"
            fi
        elif [ "${in_profile}" = true ]; then
            marker="local"
            if [ ! -f "${p_dir}/SKILL.md" ]; then
                note=" (missing SKILL.md)"
            fi
        else
            marker="available"
            if [ ! -f "${t_dir}/SKILL.md" ]; then
                note=" (missing SKILL.md)"
            fi
        fi

        printf "%-10s  %s%s\n" "${marker}" "${skill}" "${note}"
    done
}

push_skills() {
    local skills=("$@")
    for s in "${skills[@]}"; do
        if [[ ! "${s}" =~ ^[a-zA-Z0-9_-]+$ ]]; then
            echo "Error: Invalid skill name '${s}' (allowed: letters, digits, '-', '_')"
            exit 1
        fi
        if [ ! -d "${SKILLS_DIR}/${s}" ]; then
            echo "Error: Skill '${s}' does not exist in profile '${PROFILE_NAME}' (${SKILLS_DIR})"
            exit 1
        fi
        if [ ! -f "${SKILLS_DIR}/${s}/SKILL.md" ]; then
            echo "Warning: '${s}' does not contain SKILL.md"
        fi
    done

    local to_add=()
    local to_overwrite=()
    local identical=()

    for s in "${skills[@]}"; do
        local t_dir="${SKILLS_TEMPLATE_DIR}/${s}"
        local p_dir="${SKILLS_DIR}/${s}"
        if [ ! -e "${t_dir}" ]; then
            to_add+=("${s}")
        elif diff -rq "${p_dir}" "${t_dir}" >/dev/null 2>&1; then
            identical+=("${s}")
        else
            to_overwrite+=("${s}")
        fi
    done

    if [ ${#to_overwrite[@]} -gt 0 ] && [ "${FORCE}" = false ]; then
        echo "The following skill(s) already exist in templates and will be overwritten:"
        for s in "${to_overwrite[@]}"; do
            echo "  - ${s}"
        done
        read -r -p "Overwrite ${#to_overwrite[@]} existing skill(s)? [y/N] " CONFIRM || CONFIRM="n"
        if [[ ! "${CONFIRM}" =~ ^[Yy]$ ]]; then
            echo "Aborted."
            exit 1
        fi
    fi

    mkdir -p "${SKILLS_TEMPLATE_DIR}"

    for s in "${to_add[@]}"; do
        cp -r "${SKILLS_DIR}/${s}" "${SKILLS_TEMPLATE_DIR}/${s}"
        echo "  ✓ Pushed '${s}'"
    done

    for s in "${to_overwrite[@]}"; do
        rm -rf "${SKILLS_TEMPLATE_DIR:?}/${s:?}"
        cp -r "${SKILLS_DIR}/${s}" "${SKILLS_TEMPLATE_DIR}/${s}"
        echo "  ✓ Overwrote '${s}'"
    done

    for s in "${identical[@]}"; do
        echo "  - '${s}' is already identical in templates"
    done

    echo "Push complete."
}

pull_skills() {
    local template_skills=()
    mapfile -t template_skills < <( [ -d "${SKILLS_TEMPLATE_DIR}" ] && find "${SKILLS_TEMPLATE_DIR}" -mindepth 1 -maxdepth 1 -type d -exec basename {} \; | sort )
    if [ ${#template_skills[@]} -eq 0 ]; then
        echo "No skills found in templates (${SKILLS_TEMPLATE_DIR})."
        return 0
    fi

    local to_add=()
    local to_overwrite=()
    local identical=()

    for s in "${template_skills[@]}"; do
        [ -n "${s}" ] || continue
        local t_dir="${SKILLS_TEMPLATE_DIR}/${s}"
        local p_dir="${SKILLS_DIR}/${s}"
        if [ ! -e "${p_dir}" ]; then
            to_add+=("${s}")
        elif diff -rq "${t_dir}" "${p_dir}" >/dev/null 2>&1; then
            identical+=("${s}")
        else
            to_overwrite+=("${s}")
        fi
    done

    if [ ${#to_add[@]} -eq 0 ] && [ ${#to_overwrite[@]} -eq 0 ]; then
        echo "All skills in profile '${PROFILE_NAME}' are up to date."
        return 0
    fi

    if [ ${#to_overwrite[@]} -gt 0 ] && [ "${FORCE}" = false ]; then
        echo "The following skill(s) differ in profile '${PROFILE_NAME}' and will be overwritten:"
        for s in "${to_overwrite[@]}"; do
            echo "  - ${s}"
        done
        read -r -p "Overwrite ${#to_overwrite[@]} conflicting skill(s)? [y/N] " CONFIRM || CONFIRM="n"
        if [[ ! "${CONFIRM}" =~ ^[Yy]$ ]]; then
            echo "Aborted."
            exit 1
        fi
    fi

    mkdir -p "${SKILLS_DIR}"

    for s in "${to_add[@]}"; do
        cp -r "${SKILLS_TEMPLATE_DIR}/${s}" "${SKILLS_DIR}/${s}"
        echo "  ✓ Added '${s}'"
    done

    for s in "${to_overwrite[@]}"; do
        rm -rf "${SKILLS_DIR:?}/${s:?}"
        cp -r "${SKILLS_TEMPLATE_DIR}/${s}" "${SKILLS_DIR}/${s}"
        echo "  ✓ Updated '${s}'"
    done

    for s in "${identical[@]}"; do
        echo "  - '${s}' is already identical"
    done

    echo "Pull complete."
}

show_usage() {
    cat << EOF
:cla v${VERSION} - isolated AI coding environments

Usage: :cla <profile-name> [OPTIONS]
       :cla [OPTIONS]

Options:
    --list-skills         List skills and sync status
    --push-skill <name>.. Push skill(s) from profile to shared templates
    --pull-skills         Pull skills from shared templates to profile
    --force, -f           Force overwrite on skill push/pull without prompting
    --build               Force rebuild of Docker image
    --reset-dockerfile    Reset Dockerfile from template
    --reconfigure         Reset Dockerfile and open in editor
    --delete, --remove    Delete profile (config dir and Docker image)
    --version             Show version
    -h, --help            Show this help message

Examples:
    :cla work                            # Launch shell with 'work' profile
    :cla work --list-skills              # List skills and sync status for 'work'
    :cla --list-skills                   # List skills in shared templates
    :cla work --push-skill my-skill      # Push skill from 'work' to templates
    :cla work --pull-skills              # Pull template skills into 'work'
    :cla work --build                    # Force rebuild and launch
    :cla work --reset-dockerfile         # Reset 'work' Dockerfile to default
    :cla work --reconfigure              # Reset Dockerfile and open in editor
    :cla work --delete                   # Delete the 'work' profile
EOF
}

# Parse arguments
PROFILE_NAME=""
BUILD_IMAGE=false
RESET_DOCKERFILE=false
RECONFIGURE=false
DELETE_PROFILE=false
LIST_SKILLS=false
PUSH_SKILL=false
PULL_SKILLS=false
FORCE=false
PUSH_SKILL_NAMES=()

while [[ $# -gt 0 ]]; do
    case $1 in
        -h|--help)
            show_usage
            exit 0
            ;;
        --version)
            echo "v${VERSION}"
            exit 0
            ;;
        --list-skills)
            LIST_SKILLS=true
            shift
            ;;
        --push-skill)
            PUSH_SKILL=true
            shift
            while [[ $# -gt 0 ]] && [[ ! "$1" =~ ^- ]]; do
                PUSH_SKILL_NAMES+=("$1")
                shift
            done
            ;;
        --pull-skills)
            PULL_SKILLS=true
            shift
            ;;
        --force|-f)
            FORCE=true
            shift
            ;;
        --build)
            BUILD_IMAGE=true
            shift
            ;;
        --reset-dockerfile)
            RESET_DOCKERFILE=true
            shift
            ;;
        --reconfigure)
            RECONFIGURE=true
            shift
            ;;
        --delete|--remove)
            DELETE_PROFILE=true
            shift
            ;;
        --shell)
            shift
            ;;
        -*)
            echo "Error: Unknown option $1"
            show_usage
            exit 1
            ;;
        *)
            if [ -z "$PROFILE_NAME" ]; then
                PROFILE_NAME="$1"
            else
                echo "Error: Multiple profile names specified: '$PROFILE_NAME' and '$1'"
                show_usage
                exit 1
            fi
            shift
            ;;
    esac
done

if [ "${PUSH_SKILL}" = true ] && [ ${#PUSH_SKILL_NAMES[@]} -eq 0 ]; then
    echo "Error: --push-skill requires at least one skill name"
    echo ""
    show_usage
    exit 1
fi

if [ -z "$PROFILE_NAME" ]; then
    if [ "${LIST_SKILLS}" = true ]; then
        list_skills ""
        exit 0
    fi
    echo "Error: Profile name required"
    echo ""
    show_usage
    exit 1
fi

# Blocks path traversal (e.g. "../..") and invalid Docker tags.
# LC_ALL=C keeps the character class ASCII-only.
if ! ( LC_ALL=C; [[ "$PROFILE_NAME" =~ ^[a-z0-9][a-z0-9-]*$ ]] ); then
    echo "Error: Invalid profile name (allowed: lowercase letters, digits, '-')"
    exit 1
fi

IMAGE_NAME="${IMAGE_PREFIX}-${PROFILE_NAME}"
PROFILE_CONFIG_DIR="${CONFIG_DIR}/${PROFILE_NAME}"

# Profile wrappers (mirror _templates/<tool> 1:1)
CLAUDE_PROFILE_DIR="${PROFILE_CONFIG_DIR}/_claude"
OPENCODE_PROFILE_DIR="${PROFILE_CONFIG_DIR}/_opencode"
ANTIGRAVITY_PROFILE_DIR="${PROFILE_CONFIG_DIR}/_antigravity"
PI_PROFILE_DIR="${PROFILE_CONFIG_DIR}/_pi"
CODEX_PROFILE_DIR="${PROFILE_CONFIG_DIR}/_codex"
GROK_PROFILE_DIR="${PROFILE_CONFIG_DIR}/_grok"
COPILOT_PROFILE_DIR="${PROFILE_CONFIG_DIR}/_copilot"
JUNIE_PROFILE_DIR="${PROFILE_CONFIG_DIR}/_junie"

# Container mount sources
CLAUDE_DIR="${CLAUDE_PROFILE_DIR}/.claude"
CLAUDEJSON_PATH="${CLAUDE_PROFILE_DIR}/claude.json"
CLAUDE_MD_PATH="${CLAUDE_DIR}/CLAUDE.md"
CLAUDE_SETTINGS_PATH="${CLAUDE_DIR}/settings.json"
OPENCODE_CONFIG_DIR="${OPENCODE_PROFILE_DIR}/config"
OPENCODE_SHARE_DIR="${OPENCODE_PROFILE_DIR}/share"
OPENCODE_STATE_DIR="${OPENCODE_PROFILE_DIR}/state"
OPENCODE_AGENTS_PATH="${OPENCODE_CONFIG_DIR}/AGENTS.md"
ANTIGR_GEMINI_DIR="${ANTIGRAVITY_PROFILE_DIR}/.gemini"
GEMINI_PATH="${ANTIGR_GEMINI_DIR}/GEMINI.md"
PI_DIR="${PI_PROFILE_DIR}/.pi"
PI_AGENTS_PATH="${PI_DIR}/agent/AGENTS.md"
CODEX_DIR="${CODEX_PROFILE_DIR}/.codex"
CODEX_AGENTS_PATH="${CODEX_DIR}/AGENTS.md"
GROK_DIR="${GROK_PROFILE_DIR}/.grok"
COPILOT_HOME_DIR="${COPILOT_PROFILE_DIR}/.copilot"
COPILOT_AGENTS_PATH="${COPILOT_HOME_DIR}/AGENTS.md"
JUNIE_DIR="${JUNIE_PROFILE_DIR}/.junie"
JUNIE_AGENTS_PATH="${JUNIE_DIR}/AGENTS.md"
PROFILE_DOCKERFILE="${PROFILE_CONFIG_DIR}/Dockerfile"
SKILLS_DIR="${PROFILE_CONFIG_DIR}/_skills"

# Handle --delete/--remove
if [ "${DELETE_PROFILE}" = true ]; then
    if [ ! -d "${PROFILE_CONFIG_DIR}" ]; then
        echo "Error: Profile '${PROFILE_NAME}' does not exist (${PROFILE_CONFIG_DIR})"
        exit 1
    fi

    # Refuse to delete anything outside ${CONFIG_DIR}.
    case "${PROFILE_CONFIG_DIR}" in
        "${CONFIG_DIR}"/*) ;;
        *)
            echo "Error: Refusing to delete unexpected path: ${PROFILE_CONFIG_DIR}"
            exit 1
            ;;
    esac

    echo "Deleting profile '${PROFILE_NAME}':"
    echo "  - config directory: ${PROFILE_CONFIG_DIR}"
    echo "  - Docker image:     ${IMAGE_NAME}"
    read -r -p "Continue? [y/N] " CONFIRM || CONFIRM="n"
    if [[ "${CONFIRM}" =~ ^[Yy]$ ]]; then
        rm -rf "${PROFILE_CONFIG_DIR}"
        echo "  ✓ Config directory deleted"

        # Image cleanup is best-effort; the profile is already gone.
        if docker image inspect "${IMAGE_NAME}" > /dev/null 2>&1; then
            if docker rmi -f "${IMAGE_NAME}" > /dev/null; then
                echo "  ✓ Docker image deleted"
            else
                echo "  ⚠ Could not remove Docker image: ${IMAGE_NAME}"
            fi
        fi

        echo "Profile '${PROFILE_NAME}' removed."
    else
        echo "Aborted."
        exit 1
    fi
    exit 0
fi

# Handle --list-skills
if [ "${LIST_SKILLS}" = true ]; then
    if [ ! -d "${PROFILE_CONFIG_DIR}" ]; then
        echo "Error: Profile '${PROFILE_NAME}' does not exist (${PROFILE_CONFIG_DIR})"
        exit 1
    fi
    list_skills "${PROFILE_NAME}"
    exit 0
fi

# Handle --push-skill
if [ "${PUSH_SKILL}" = true ]; then
    if [ ! -d "${PROFILE_CONFIG_DIR}" ]; then
        echo "Error: Profile '${PROFILE_NAME}' does not exist (${PROFILE_CONFIG_DIR})"
        exit 1
    fi
    push_skills "${PUSH_SKILL_NAMES[@]}"
    exit 0
fi

# Handle --pull-skills
if [ "${PULL_SKILLS}" = true ]; then
    if [ ! -d "${PROFILE_CONFIG_DIR}" ]; then
        echo "Error: Profile '${PROFILE_NAME}' does not exist (${PROFILE_CONFIG_DIR})"
        exit 1
    fi
    pull_skills
    exit 0
fi

# --- Create directory structure ---
if [ ! -d "${PROFILE_CONFIG_DIR}" ]; then
    if [ "${RESET_DOCKERFILE}" = true ] || [ "${RECONFIGURE}" = true ]; then
        echo "Error: Profile '${PROFILE_NAME}' does not exist (${PROFILE_CONFIG_DIR})"
        echo "Run \`:cla ${PROFILE_NAME}\` first to create it."
        exit 1
    fi

    echo "Profile '${PROFILE_NAME}' does not exist (${PROFILE_CONFIG_DIR})."
    read -r -p "Create it? [Y/n] " CONFIRM_CREATE || CONFIRM_CREATE="y"
    case "${CONFIRM_CREATE}" in
        ""|[Yy]*) ;;
        *)
            echo "Aborted."
            exit 1
            ;;
    esac
fi

mkdir -p "${PROFILE_CONFIG_DIR}"

seed_dir() {
    local source_dir="$1"
    local target_dir="$2"

    # Existing profile data wins; templates are only needed for new targets.
    if [ -d "${target_dir}" ]; then
        return 0
    fi

    if [ ! -d "${source_dir}" ]; then
        echo "Error: Missing tool template directory: ${source_dir}"
        exit 1
    fi

    mkdir -p "$(dirname "${target_dir}")"
    cp -r "${source_dir}" "${target_dir}"
}

# Seed a file only if absent. Targets live in container-writable dirs, so
# refuse symlinks to avoid writing to host paths chosen by the sandbox.
seed_file() {
    local source_file="$1"
    local target_file="$2"

    if [ -L "${target_file}" ] || [ -L "$(dirname "${target_file}")" ]; then
        echo "Error: Refusing to seed through symlink: ${target_file}"
        exit 1
    fi

    [ -e "${target_file}" ] || cp "${source_file}" "${target_file}"
}

# Seed complete tool configuration trees only when their profile targets are new.
# Each template root mirrors its profile wrapper 1:1.
seed_dir "${CLAUDE_TEMPLATE_DIR}" "${CLAUDE_PROFILE_DIR}"
seed_dir "${OPENCODE_TEMPLATE_DIR}" "${OPENCODE_PROFILE_DIR}"
seed_dir "${ANTIGRAVITY_TEMPLATE_DIR}" "${ANTIGRAVITY_PROFILE_DIR}"
seed_dir "${PI_TEMPLATE_DIR}" "${PI_PROFILE_DIR}"
seed_dir "${CODEX_TEMPLATE_DIR}" "${CODEX_PROFILE_DIR}"
seed_dir "${GROK_TEMPLATE_DIR}" "${GROK_PROFILE_DIR}"
seed_dir "${JUNIE_TEMPLATE_DIR}" "${JUNIE_PROFILE_DIR}"

seed_skills() {
    if [ -d "${SKILLS_DIR}" ]; then
        return 0
    fi
    mkdir -p "${SKILLS_DIR}"
    if [ -d "${SKILLS_TEMPLATE_DIR}" ]; then
        for s in "${SKILLS_TEMPLATE_DIR}"/*; do
            [ -d "${s}" ] || continue
            cp -r "${s}" "${SKILLS_DIR}/"
        done
    fi
}
seed_skills

# Runtime/state directories are intentionally separate from seed templates.
mkdir -p "${CLAUDE_DIR}"
mkdir -p "${OPENCODE_SHARE_DIR}"
mkdir -p "${OPENCODE_STATE_DIR}"
mkdir -p "${OPENCODE_CONFIG_DIR}"
mkdir -p "${ANTIGR_GEMINI_DIR}/config"
mkdir -p "${PI_DIR}/agent"
mkdir -p "${CODEX_DIR}"
mkdir -p "${COPILOT_HOME_DIR}"
mkdir -p "${GROK_DIR}"
mkdir -p "${JUNIE_DIR}"
mkdir -p "${SKILLS_DIR}"

# --- Copy templates ---
if [ ! -f "${DOCKERFILE_TEMPLATE}" ]; then
    echo "Error: Could not find Dockerfile template at $DOCKERFILE_TEMPLATE"
    exit 1
fi
if [ ! -f "${AGENTS_TEMPLATE}" ]; then
    echo "Error: Could not find AGENTS.md template at $AGENTS_TEMPLATE"
    exit 1
fi
if [ ! -f "${CLAUDEJSON_TEMPLATE}" ]; then
    echo "Error: Could not find claude.json template at $CLAUDEJSON_TEMPLATE"
    exit 1
fi
if [ ! -f "${CLAUDE_SETTINGS_TEMPLATE}" ]; then
    echo "Error: Could not find settings.json template at $CLAUDE_SETTINGS_TEMPLATE"
    exit 1
fi

# Copy Dockerfile and .dockerignore from template if they don't exist
seed_file "${DOCKERFILE_TEMPLATE}" "${PROFILE_DOCKERFILE}"
if [ -f "${DOCKERIGNORE_TEMPLATE}" ]; then
    seed_file "${DOCKERIGNORE_TEMPLATE}" "${PROFILE_CONFIG_DIR}/.dockerignore"
fi

# Re-seed if deleted; otherwise Docker would create a directory in its place.
seed_file "${CLAUDEJSON_TEMPLATE}" "${CLAUDEJSON_PATH}"
seed_file "${CLAUDE_SETTINGS_TEMPLATE}" "${CLAUDE_SETTINGS_PATH}"

# Propagate the shared AGENTS.md template to each tool's instruction file.
seed_file "${AGENTS_TEMPLATE}" "${OPENCODE_AGENTS_PATH}"
seed_file "${AGENTS_TEMPLATE}" "${GEMINI_PATH}"
seed_file "${AGENTS_TEMPLATE}" "${CLAUDE_MD_PATH}"
seed_file "${AGENTS_TEMPLATE}" "${PI_AGENTS_PATH}"
seed_file "${AGENTS_TEMPLATE}" "${COPILOT_AGENTS_PATH}"
seed_file "${AGENTS_TEMPLATE}" "${CODEX_AGENTS_PATH}"
seed_file "${AGENTS_TEMPLATE}" "${JUNIE_AGENTS_PATH}"

# Handle --reset-dockerfile
if [ "${RESET_DOCKERFILE}" = true ]; then
    echo "Resetting Dockerfile for profile '${PROFILE_NAME}'..."
    cp "${DOCKERFILE_TEMPLATE}" "${PROFILE_DOCKERFILE}"
    echo "  ✓ Dockerfile reset from template"
    echo "Reset complete."
    exit 0
fi

# Handle --reconfigure
if [ "${RECONFIGURE}" = true ]; then
    echo "Resetting Dockerfile for profile '${PROFILE_NAME}'..."
    cp "${DOCKERFILE_TEMPLATE}" "${PROFILE_DOCKERFILE}"
    echo "  ✓ Dockerfile reset from template"
    EDITOR="${VISUAL:-${EDITOR:-vi}}"
    echo "Opening Dockerfile in ${EDITOR}..."
    "${EDITOR}" "${PROFILE_DOCKERFILE}"
    echo "Reconfigure complete."
    exit 0
fi

# --- Directory guard ---
# Ask before mounting a directory this profile hasn't used. Exact-path match.
ALLOWED_DIRS_FILE="${PROFILE_CONFIG_DIR}/.allowed_dirs"
CANONICAL_PWD="$(pwd -P)"

dir_is_allowed() {
    [ -f "${ALLOWED_DIRS_FILE}" ] && grep -Fxq -- "${CANONICAL_PWD}" "${ALLOWED_DIRS_FILE}"
}

if ! dir_is_allowed; then
    echo "Profile '${PROFILE_NAME}' has not been used in this directory before:"
    echo "  ${CANONICAL_PWD}"
    read -r -p "Mount it into the sandbox? [y]es and remember / [o]nce / [N]o " DIR_CONFIRM || DIR_CONFIRM="n"
    case "${DIR_CONFIRM}" in
        y|Y)
            printf '%s\n' "${CANONICAL_PWD}" >> "${ALLOWED_DIRS_FILE}"
            ;;
        o|O)
            ;;
        *)
            echo "Aborted."
            exit 1
            ;;
    esac
fi

# Build the Docker image if it doesn't exist or the --build flag is used
if [ "${BUILD_IMAGE}" = true ] || ! docker image inspect "${IMAGE_NAME}" > /dev/null 2>&1; then
    echo "Building Docker image: ${IMAGE_NAME}"
    docker build --no-cache \
        -t "${IMAGE_NAME}" \
        -f "${PROFILE_DOCKERFILE}" \
        --build-context install_scripts="${INSTALL_SCRIPTS_SRC}" \
        "${PROFILE_CONFIG_DIR}"
fi

HOST_TZ=$(timedatectl show --property=Timezone --value 2>/dev/null || true)

# --- Build docker run command ---
DOCKER_RUN=(
    docker run
    --rm
    -it
    -v "${CANONICAL_PWD}:/workspace/${CANONICAL_PWD}"
    -v "${CLAUDE_DIR}:/home/cla/.claude"
    -v "${CLAUDEJSON_PATH}:/home/cla/.claude.json"
    -v "${PI_DIR}:/home/cla/.pi"
    -v "${OPENCODE_SHARE_DIR}:/home/cla/.local/share/opencode"
    -v "${OPENCODE_STATE_DIR}:/home/cla/.local/state/opencode"
    -v "${OPENCODE_CONFIG_DIR}:/home/cla/.config/opencode"
    -v "${ANTIGR_GEMINI_DIR}:/home/cla/.gemini"
    -v "${COPILOT_HOME_DIR}:/home/cla/.copilot"
    -v "${CODEX_DIR}:/home/cla/.codex"
    -v "${GROK_DIR}:/home/cla/.grok"
    -v "${JUNIE_DIR}:/home/cla/.junie"
    -v "${SKILLS_DIR}:/home/cla/.agents/skills"
    -v "${SKILLS_DIR}:/home/cla/.claude/skills"
    -v "${SKILLS_DIR}:/home/cla/.config/opencode/skills"
    -v "${SKILLS_DIR}:/home/cla/.gemini/config/skills"
    -v "${SKILLS_DIR}:/home/cla/.grok/skills"
    -v /etc/localtime:/etc/localtime:ro
    -e TERM=xterm-256color
    -e TZ="${TZ:-${HOST_TZ:-Europe/Helsinki}}"
    -e SAMPORAPELI_ZSH_ENVIRONMENT="${IMAGE_NAME}"
    --cap-drop=ALL
    --security-opt=no-new-privileges
    --memory=4g
    --cpus=2
    --pids-limit=100
    -w "/workspace/${CANONICAL_PWD}"
    "${IMAGE_NAME}"
    /bin/zsh
)

"${DOCKER_RUN[@]}"
